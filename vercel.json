{
  "version": 2,
  "framework": null,
  "installCommand": "npm install",
  "buildCommand": "",
  "outputDirectory": "public",
  "functions": {
    "api/**/*.js": {
      "maxDuration": 30
    }
  },
  "rewrites": [
    { "source": "/api/verify/:token", "destination": "/api/verify/[token].js" },
    { "source": "/api/submit",        "destination": "/api/submit.js" },
    { "source": "/api/health",        "destination": "/api/health.js" }
  ]
}

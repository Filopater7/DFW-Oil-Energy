# ============================================================
#  DFW Oil Energy – Driver Tracking Portal
#  Environment Variables
#
#  FOR TESTING ON VERCEL: No variables are required.
#  Just deploy — submissions are stored in memory.
#
#  FOR PRODUCTION: Add the optional variables below in
#  Vercel Dashboard → Project → Settings → Environment Variables
# ============================================================

# ── Server (local dev only) ─────────────────────────────────
PORT=3000

# ── Google Sheets (Apps Script Webhook) ─────────────────────
# Paste your Google Apps Script Web App URL here
# Deploy script as "Anyone" (no login required)
GOOGLE_SHEET_URL=https://script.google.com/macros/s/YOUR_SCRIPT_ID/exec

# ── Email Notifications (optional) ──────────────────────────
# Leave blank to skip. App works fine without it.
# Gmail: generate an App Password at https://myaccount.google.com/apppasswords
# SendGrid: host=smtp.sendgrid.net, port=587, user=apikey, pass=SG.xxxxx
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM=
EMAIL_TO=

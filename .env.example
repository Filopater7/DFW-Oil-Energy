# ============================================================
#  DFW Oil Energy – Driver Tracking Portal
#  Environment Configuration Template
#
#  INSTRUCTIONS:
#  1. Copy this file and rename it to .env
#  2. Fill in your actual credentials below
#  3. NEVER commit the .env file to version control
# ============================================================

# ── Server ──────────────────────────────────────────────────
PORT=3000

# ── Google Sheets Integration ────────────────────────────────
# Step 1: Go to https://console.cloud.google.com
# Step 2: Create a project → enable "Google Sheets API"
# Step 3: Create a Service Account → download JSON key file
# Step 4: Share your Google Sheet with the service account email
# Step 5: Copy the spreadsheet ID from the Sheet URL:
#         https://docs.google.com/spreadsheets/d/<SPREADSHEET_ID>/edit

GOOGLE_SHEETS_ID=your_google_spreadsheet_id_here
GOOGLE_SERVICE_ACCOUNT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com
# Paste the private_key value from your downloaded JSON key (keep the \n line breaks)
GOOGLE_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\nYOUR_PRIVATE_KEY_HERE\n-----END RSA PRIVATE KEY-----\n"

# ── Email Notifications (SMTP / Nodemailer) ──────────────────
# For Gmail: use App Password (not your regular password)
#   https://myaccount.google.com/apppasswords
# For SendGrid SMTP: host=smtp.sendgrid.net, port=587, user=apikey, pass=<your_api_key>
# For Mailgun SMTP:  host=smtp.mailgun.org, port=587

EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
# Set to true only if using port 465 (SSL); for 587 (TLS) keep false
EMAIL_SECURE=false
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your_app_password_here
# "From" address shown in the email (optional – defaults to EMAIL_USER)
EMAIL_FROM="DFW Oil Energy <no-reply@dfwoilenergy.com>"
# Comma-separated list of recipients for submission notifications
EMAIL_TO=admin@dfwoilenergy.com,dispatch@dfwoilenergy.com

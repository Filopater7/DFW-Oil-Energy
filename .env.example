# ============================================================
#  DFW Oil Energy – Driver Tracking Portal
#  Environment Variables Template
#
#  HOW TO USE LOCALLY:
#    1. Copy this file: copy .env.example .env
#    2. Fill in your values below
#    3. Run: npm start
#
#  HOW TO USE ON VERCEL:
#    Dashboard → Project → Settings → Environment Variables
#    Add each key/value listed below
# ============================================================

# ── Server (local only – Vercel sets its own port) ──────────
PORT=3000

# ── MongoDB Atlas ────────────────────────────────────────────
# 1. Go to https://cloud.mongodb.com and create a FREE M0 cluster
# 2. Click "Connect" → "Drivers" → copy the connection string
# 3. Replace <username>, <password>, <cluster> in the URI below
# 4. In Atlas: Network Access → Add IP → 0.0.0.0/0 (allow all for Vercel)
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/dfw-oil-energy?retryWrites=true&w=majority

# ── Google Sheets Integration ────────────────────────────────
# 1. https://console.cloud.google.com → Enable "Google Sheets API"
# 2. Create a Service Account → download JSON key
# 3. Share your Google Sheet with the service account email (Editor)
# 4. Get the Spreadsheet ID from the Sheet URL:
#    https://docs.google.com/spreadsheets/d/<SPREADSHEET_ID>/edit
GOOGLE_SHEETS_ID=your_google_spreadsheet_id_here
GOOGLE_SERVICE_ACCOUNT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com
# Paste the private_key from the downloaded JSON (keep the literal \n — do NOT expand to real newlines)
GOOGLE_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\nYOUR_KEY_HERE\n-----END RSA PRIVATE KEY-----\n"

# ── Email Notifications (SMTP) ───────────────────────────────
# Gmail: use an App Password (not your regular password)
#   https://myaccount.google.com/apppasswords
# SendGrid: host=smtp.sendgrid.net, port=587, user=apikey, pass=SG.xxxxx
# Mailgun:  host=smtp.mailgun.org,  port=587
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
# true only for port 465 (SSL). For port 587 (TLS) keep false
EMAIL_SECURE=false
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your_16_char_app_password
# Display name in the From field (optional)
EMAIL_FROM="DFW Oil Energy <no-reply@dfwoilenergy.com>"
# Where to send submission notifications (comma-separated)
EMAIL_TO=admin@dfwoilenergy.com
